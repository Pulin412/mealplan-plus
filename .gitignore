local.properties

# Personal developer seed data — not for distribution
/developer_data/
backup_snapshot_*/

# Web app
node_modules/
webapp/.next/
webapp/out/
webapp/.env.local
webapp/.env
webapp/.idea/

# Root env (local secrets)
.env

# Misplaced android module directory
/app/

# Personal Claude memory — never commit
CLAUDE.local.md
**/CLAUDE.local.md
CLAUDE.md.bak

# Design handoff bundle (reference only — not part of the build)
design_v2/

# Local-only dev H2 seeder (run manually when testing) — never commit
scripts/dev-seed-h2.py

# local-up.sh config (holds the Firebase key) + its backend log — never commit
scripts/local-seed.env
scripts/.local-backend.log

# Python bytecode cache (from running local scripts)
__pycache__/
*.pyc

# Android signing keystore — NEVER commit (leaked signing keys let anyone sign APKs as this app)
keystore/
*.jks
*.keystore
