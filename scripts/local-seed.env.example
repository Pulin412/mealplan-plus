# Copy to scripts/local-seed.env (gitignored) and fill in. Used by scripts/local-up.sh.
#
# Firebase Web API key for this project — lets the seeder mint a login-able dev account
# (Project settings → General → Web API key). It's a public client key, but keep the real
# dev-seed.env out of git anyway.
FIREBASE_WEB_API_KEY=

# The dev account you'll sign into the app with (created automatically on first run).
DEV_EMAIL=dev@mealplan.test
DEV_PASSWORD=mealplan123

# Backend base URL (default is the local bootRun H2 server). Must be localhost — local-up.sh refuses
# a remote URL, and forces in-memory H2 (never touches Neon/prod).
API_BASE=http://localhost:8080

# Do NOT set DB_URL / SPRING_PROFILES_ACTIVE here — local-up.sh unsets them so the backend always
# uses local in-memory H2. This file is for local dev only.
